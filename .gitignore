# =============================================================================
# ThunderfamEats Backend — .gitignore
# Yii 1.x (Karenderia Multiple Restaurant System) PHP application.
# Goal: keep source, config templates and docs in the repo; keep secrets,
# credentials, user data, dumps, backups, logs, caches and machine files OUT.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Secrets & credentials — NEVER commit
# -----------------------------------------------------------------------------
# Real runtime config holds DB user/password and CRON_KEY. Commit the sanitized
# template (k-config.sample.php) instead; each environment copies it to k-config.php.
/k-config.php

# Environment files of any flavour
.env
.env.*
!.env.example
!.env.sample

# Firebase service-account / admin-SDK private keys (JSON) anywhere in the tree
*firebase-adminsdk*.json
*-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# Generic secret material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.*
credentials.*
service-account*.json

# -----------------------------------------------------------------------------
# 2. Database dumps
# -----------------------------------------------------------------------------
*.sql
*.sql.gz
*.dump
karenderia.sql
# Keep versioned per-module schema installers (see negations below)
!protected/modules/**/filesupdate/*.sql

# -----------------------------------------------------------------------------
# 3. User-uploaded content (large binary media, not source; 400 MB+)
#    Also historically contained leaked Firebase admin keys.
# -----------------------------------------------------------------------------
/upload/
/backoffice/upload/

# -----------------------------------------------------------------------------
# 4. Backups & archives
# -----------------------------------------------------------------------------
/backup1/
/touchpay-backup-*/
*-backup-*/
*.bak
*.backup
*.old
*.orig
*~

# -----------------------------------------------------------------------------
# 5. Runtime, logs & cache (generated by the app)
# -----------------------------------------------------------------------------
protected/runtime/*
backoffice/protected/runtime/*
!protected/runtime/.gitkeep
!backoffice/protected/runtime/.gitkeep
assets/[0-9a-f]*/
backoffice/assets/[0-9a-f]*/
*.log
*.cache
state.bin

# -----------------------------------------------------------------------------
# 6. Diagnostics / info-disclosure endpoints (should not live in a repo)
# -----------------------------------------------------------------------------
phpinfo.php

# -----------------------------------------------------------------------------
# 7. Dependencies restorable from a manifest
# -----------------------------------------------------------------------------
node_modules/
vendor/composer/
.pnp.*

# -----------------------------------------------------------------------------
# 8. OS-generated files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# 9. IDE / editor settings
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.iml
nbproject/
.settings/
.project
.buildpath

# -----------------------------------------------------------------------------
# 10. Build / temp artifacts
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
dist/
build/
